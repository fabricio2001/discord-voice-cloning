DISCORD_TOKEN=cole_o_token_do_bot_aqui
DISCORD_CLIENT_ID=cole_o_application_id_aqui

# Opcional: durante o desenvolvimento, registra os comandos imediatamente
# apenas neste servidor. Sem esta variável, os comandos serão globais e podem
# levar algum tempo para aparecer.
DISCORD_GUILD_ID=

# Pasta onde as sessões serão salvas (relativa à raiz do projeto).
RECORDINGS_DIR=recordings

# Catálogo das referências clonadas e arquivos TTS temporários.
VOICES_DIR=voices
SYNTHESIS_DIR=outputs/tts

# Projeto Python que contém clone_sample.py, modelos e a .venv do Chatterbox.
# O bot encontra automaticamente a raiz deste monorepo. Defina esta variável
# somente quando o serviço Python estiver em outro local.
# VOICE_CLONING_DIR=../..
# VOICE_CLONING_PYTHON=../../.venv/Scripts/python.exe
# VOICE_CLONING_SCRIPT=../../clone_sample.py
# VOICE_CLONING_TEMP=.tmp/python

# Configurações opcionais do /vr-cover.
# Instale o motor executando instalar-cover.ps1 na raiz do monorepo.
# Linhas iniciadas com # estão comentadas: os padrões já funcionam nesta estrutura.
# Para personalizar, copie a opção para o .env, retire o # e reinicie o bot.

# Executável Python usado exclusivamente para gerar covers (Seed-VC + Demucs).
# Por padrão, usa .cover-venv/Scripts/python.exe dentro de VOICE_CLONING_DIR.
# Só altere se o ambiente de cover estiver em outro local. Não use o Python do
# Chatterbox (.venv), pois os dois motores têm dependências diferentes.
# COVER_PYTHON=../../.cover-venv/Scripts/python.exe

# Pasta temporária de trabalho dos covers, relativa à pasta de execução do bot
# (normalmente Discord). Também aceita um caminho absoluto.
# Guarda o áudio de entrada, a cópia da referência, os vocais e a mixagem.
# Os temporários são apagados ao concluir ou falhar; o MP3 enviado fica no Discord.
# Não é a pasta dos modelos nem um arquivo permanente dos covers gerados.
# Se o bot for encerrado à força, podem restar temporários nesta pasta.
# COVER_OUTPUT_DIR=outputs/covers

# Reprodução direta de anexos com /vr-tocar.
# O padrão encontra o FFmpeg instalado por instalar-cover.ps1.
# FFMPEG_PATH=C:/caminho/para/ffmpeg.exe
# PLAYBACK_OUTPUT_DIR=outputs/playback
